<?xml version="1.0"?>
<package format="3">
  <name>spinearm_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 bridges around the existing arm server (ZMQ) and tracker tap (UDP), plus calibration TF (stage 1, observe-only).</description>
  <maintainer email="90886911+geebab@users.noreply.github.com">Donghyun Won</maintainer>
  <license>MPL-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>spinearm_msgs</exec_depend>
  <exec_depend>spinearm_description</exec_depend>
  <exec_depend>python3-zmq</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
